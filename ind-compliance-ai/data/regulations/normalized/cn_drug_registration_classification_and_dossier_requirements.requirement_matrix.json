      "source_article_no": 8,
      "section_no": 2,
      "section_title": "相关注册管理要求",
      "source_heading": "（一）",
      "registration_classes": [
        "1类"
      ],
      "applicable_stage": "registration_classification",
      "requirement_type": "classification_eligibility",
      "requirement_level": "required",
      "requirement_text": "（一）化学药品1类为创新药，应含有新的结构明确的、具有药理作用的化合物，且具有临床价值，不包括改良型新药中2.1类的药品。含有新的结构明确的、具有药理作用的化合物的新复方制剂，应按照化学药品1类申报。",
      "expected_material_evidence": [
        "general_registration_dossier"
      ],
      "review_focus": "确认申报材料能证明新结构明确、具有药理作用且具有临床价值。",
      "citation_anchor": "cn_drug_registration_classification_and_dossier_requirements#art_008",
      "source_path": "data\\regulations\\药品注册分类及申报资料要求.doc",
      "source_filename": "药品注册分类及申报资料要求.doc"
    },
    {
      "requirement_id": "cn_drug_registration_classification_and_dossier_requirements:req_class_2_clinical_advantage",
